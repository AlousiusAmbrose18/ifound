# Copy to .env and replace all four placeholders with separate random values.
# Generate each with: openssl rand -hex 32
MYSQL_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
API_TOKEN=replace-with-random-api-token-at-least-32-characters
APP_PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-random-admin-password-at-least-12-characters
